# ====================================================================
# Job Autopilot Pipeline Environment Configuration
# ====================================================================

# Google Gemini API Configuration (Free Tier: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-flash

# OpenAI API Configuration (Optional alternative)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL_NAME=gpt-4o

# Supabase API Configuration (Required for Database Layer)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key_here

# Supabase PostgreSQL Connection String (Required for PGVector Resume RAG)
SUPABASE_CONNECTION_STRING=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# 2Captcha Configuration (Optional: for solving reCAPTCHA/hCaptcha challenges)
TWOCAPTCHA_API_KEY=your_2captcha_api_key_here

# Pipeline Settings
RESUME_PATH=assets/resume_alex_morgan.pdf
MIN_MATCH_SCORE=70
HEADLESS=true

# Default Greenhouse Boards to Scrape (comma-separated company tokens or URLs)
DEFAULT_GREENHOUSE_BOARDS=automattic,canonical,gitlab,docker
